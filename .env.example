# Required for model calls
GROQ_API_KEY=your_groq_api_key

# Optional runtime settings
CODEPILOT_MODEL=openai/gpt-oss-120b
CODEPILOT_PROVIDER=groq
# Optional OpenAI-compatible endpoint (OpenCode, Ollama, vLLM, LiteLLM, etc.)
# CODEPILOT_API_BASE=http://localhost:11434/v1
CODEPILOT_RECURSION_LIMIT=100
CODEPILOT_DEBUG=false
